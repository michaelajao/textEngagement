# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter / notebook checkpoints
.ipynb_checkpoints/

# Environment and local config
.env
.env.*
*.local

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo

# OS-generated files
.DS_Store
Thumbs.db

# Participant data - NEVER commit. Special-category health data (verbatim
# writing, forum posts, profiles, SWEMWBS scores). Obtain under the data-sharing
# agreement and place locally in data/.
data/

# All generated outputs (regenerate with: python -m src.analysis.run_all).
# output/features/ also carries raw participant text, so the whole tree stays out.
output/

# Word lock files
~$*

# Slide decks (~40 MB each) are kept locally in doc/slides/, not in the repo
doc/slides/*.pptx

# LaTeX build artifacts
*.aux
*.log
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
*.blg
*.bbl
