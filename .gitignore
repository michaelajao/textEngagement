# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter / notebook checkpoints
.ipynb_checkpoints/

# Environment and local config
.env
.env.*
*.local

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo

# OS-generated files
.DS_Store
Thumbs.db

# Participant data - NEVER commit. Special-category health data (verbatim
# writing, forum posts, profiles, SWEMWBS scores). Obtain under the data-sharing
# agreement and place locally in data/.
data/

# All generated outputs (regenerate with: python -m src.analysis.run_all).
# output/features/ also carries raw participant text, so the whole tree stays out.
output/
emails/
# Word lock files
~$*

# Slide decks (~37 MB each) are kept locally in doc/slides/, not in the repo.
# NOTE: two decks were committed before this rule was active and are still
# tracked; ignoring them here does not untrack them. To drop them from future
# commits:  git rm --cached "doc/slides/*.pptx"
doc/
doc/slides/*.pptx

# LaTeX build artifacts
*.aux
*.log
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
*.blg
*.bbl

# Working backups made while editing Word builds
*.pretitle.docx
*.prerewrite.docx
*.backup.docx
*.pretitle.pretitle.docx

# Further LaTeX build artefacts
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.xdv
*.run.xml
*.bcf
*-blx.bib
*.figlist
*.makefile
*.figlist-*
*.auxlock

# Machine-local editor and agent settings
.claude/settings.local.json

# Scratch and temporary working files
scratch/
tmp/
*.tmp
~$*.docx
~$*.xlsx
~$*.pptx
doc/email_draft.md
doc/JMIR-HOPEDataAnalysis-MA-20260826.docx
doc/multimedia_appendices.docx
doc/writing_engagement_paper.pdf
doc/writing_engagement_paper.tex
doc/writing_engagement_paper.tex

# Co-authors' review comments and my replies. Other people's candid
# correspondence about unpublished work; kept locally, never in the repo.
doc/comments/
doc/emails/
doc/response_to_comments.*
doc/archive/*comments-with-responses*

# Internal working notes and draft correspondence
doc/email_draft.md
doc/BUILD_REPORT.md
doc/CHANGES_FOR_TEAM.md
doc/SEND_PACKAGE.md
doc/number_reconciliation.csv
doc/reference_audit.csv

# Third-party material we do not hold redistribution rights to
doc/InstructionsForAuthorsOfJMIR.docx
