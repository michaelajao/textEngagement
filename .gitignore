# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter / notebook checkpoints
.ipynb_checkpoints/

# Environment and local config
.env
.env.*
*.local

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo

# OS-generated files
.DS_Store
Thumbs.db

# Participant data - NEVER commit. Special-category health data (verbatim
# writing, forum posts, profiles, SWEMWBS scores). Obtain under the data-sharing
# agreement and place locally in data/.
data/

# All generated outputs (regenerate with: python -m src.analysis.run_all).
# output/features/ also carries raw participant text, so the whole tree stays out.
output/
emails/
# Word lock files
~$*

# LaTeX build artifacts
*.aux
*.log
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
*.blg
*.bbl

# Working backups made while editing Word builds
*.pretitle.docx
*.prerewrite.docx
*.backup.docx
*.pretitle.pretitle.docx

# Further LaTeX build artefacts
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.xdv
*.run.xml
*.bcf
*-blx.bib
*.figlist
*.makefile
*.figlist-*
*.auxlock

# Machine-local editor and agent settings
.claude/settings.local.json

# Scratch and temporary working files
scratch/
tmp/
*.tmp
~$*.docx
~$*.xlsx
~$*.pptx

# ---------------------------------------------------------------------------
# The manuscript and everything around it stays LOCAL. doc/ holds the paper,
# the appendices, the archived drafts, co-authors' candid review comments, my
# replies, internal working notes, the slide decks (~37 MB each) and
# third-party material we do not hold redistribution rights to. None of it
# belongs in a shared repo, so the whole tree is ignored and was purged from
# history on 2026-08-28. Keep local copies backed up yourself -- git is no
# longer doing it for you.
# ---------------------------------------------------------------------------
doc/